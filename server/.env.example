# Server Configuration
PORT=5000

# MongoDB Connection String
# Replace with your MongoDB Atlas connection string or local MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# JWT Secret Key for authentication
# Generate a secure random string for production
JWT_SECRETKEY=your-secure-secret-key-here

# RapidAPI Key (optional - for external API integrations)
RAPIDAPI_KEY=your-rapidapi-key-here

# Clerk Authentication Keys
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Judge0 Code Execution API
# For local Judge0: http://127.0.0.1:2358
# For RapidAPI hosted Judge0: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=http://127.0.0.1:2358

# Judge0 Redis Password (if using local Judge0)
JUDGE0_REDIS_PASSWORD=your-redis-password
